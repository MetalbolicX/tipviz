{
  "name": "tipviz",
  "version": "3.0.0",
  "description": "Framework-agnostic a tooltip Web Components for modern web applications. Focused on data visualization.",
  "type": "module",
  "main": "./dist/index.umd.js",
  "types": "./dist/index.d.mts",
  "homepage": "https://metalbolicx.github.io/tipviz/",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "tooltip",
    "visualization",
    "typescript",
    "vanilla-js"
  ],
  "scripts": {
    "docs": "docsify serve docs",
    "build": "vite build",
    "dev": "vite",
    "tsdown:build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:cov": "vitest run --coverage",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm run validate",
    "prepack": "pnpm run tsdown:build",
    "publish:dry-run": "pnpm publish --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "José Martínez Santana"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MetalbolicX/tipviz.git"
  },
  "bugs": {
    "url": "https://github.com/MetalbolicX/tipviz/issues"
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3": "^7.4.3",
    "@vitest/coverage-v8": "^4.1.10",
    "d3": "^7.9.0",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tsdown": "^0.22.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "module": "./dist/index.mjs"
}
